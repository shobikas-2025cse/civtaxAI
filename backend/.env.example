# =============================================================================
# CivTax AI - Backend Environment Variables
# =============================================================================
# Copy this file to .env and fill in your real credentials.
# NEVER commit the .env file to Git.
# NEVER paste real credentials in this file — this file IS committed to Git.
# =============================================================================

# Supabase PostgreSQL connection string
# How to find this:
#   1. Go to https://supabase.com/dashboard
#   2. Select your "CivTaxAI" project
#   3. Go to Project Settings → Database
#   4. Copy the "Connection string (URI)" — choose "Transaction" mode (port 6543)
#   5. Replace [YOUR-PASSWORD] with your actual database password
#
# Format: postgresql://postgres.PROJECT_REF:PASSWORD@HOST:PORT/postgres
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:6543/postgres

# Twilio Verify SMS Credentials
# How to get these:
#   1. Sign up / log in to your Twilio Console (https://www.twilio.com/console)
#   2. Copy Account SID & Auth Token from Account Info (Dashboard homepage)
#   3. Go to Console -> Verify -> Services and create a Service (e.g. "CivTax Verification")
#   4. Copy the Service SID (starts with VA...)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
